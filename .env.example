# Database
DATABASE_URL=sqlite:///./resume_screening.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
RESUME_DIR=./resumes
JOB_DIR=./backend/storage/jobs

# NLP Models
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Prevents TensorFlow/Keras import errors when TF is installed alongside sentence-transformers
TRANSFORMERS_NO_TF=1
TF_ENABLE_ONEDNN_OPTS=0

# AI Providers (optional — system works without these)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
PREFERRED_AI_PROVIDER=openai
